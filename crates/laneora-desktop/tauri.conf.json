{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Laneora Rust",
  "version": "0.1.0",
  "identifier": "com.induswebagency.laneora",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Laneora Rust",
        "width": 440,
        "height": 680,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png"]
  }
}
